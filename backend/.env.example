# =============================================================================
# Configuración de Neon (PostgreSQL Serverless) para Prisma + NestJS
# =============================================================================
# En Neon existen dos URLs de conexión:
# 1. DATABASE_URL (con "-pooler" en el hostname): usa PgBouncer/connection pooling
#    para el tráfico normal de la aplicación serverless.
# 2. DIRECT_URL (sin "-pooler"): conexión directa a Postgres requerida por
#    Prisma Migrate (`npx prisma migrate dev`) para ejecutar DDL y locks.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

PORT=3000
